# Optional secrets. Copy to .env (gitignored) only if you need the paid
# recognition path. Everything else is configured in docker-compose.yml,
# where the values are literal and visible.

# Host path for captured media. The container always sees /data/captures.
CAPTURE_STORE=./data

# ---- paid species recognition (optional, NOT wired into the server) ----
#
# server/nvts_client.py is a standalone module that reads these when you call
# it yourself. The running container does not import it, so setting these
# changes nothing on its own. Endpoints and the auth scheme: docs/PROTOCOL.md.
#
# These are real account credentials. Keep them here or in container secrets,
# never in a committed file.
NVS_EMAIL=
NVS_PASSWORD=
NVS_LOGIN_URL=https://localweb.netvue.co/v1/users/login
NVS_API_BASE=https://capiv3.nvts.co
